# Discord bot token (from Discord Developer Portal)
DISCORD_BOT_TOKEN=

# Discord webhook URL for tee time notifications
NOTIFICATION_WEBHOOK_URL=

# ForeUp JWT — log in to a ForeUp course site, copy from a booking API request header
# (x-authorization: Bearer <token>). Expires periodically; re-copy when it does.
FOREUP_JWT=

# ForeUp booking class for Advantage Card holders (Baltimore County: 35)
# Controls the extended 16-day booking window. Leave empty to use public window only.
FOREUP_BOOKING_CLASS=35

# Server port for the status API
PORT=4000

# How many days ahead to look for tee times (advantage window = 17, public = 9)
LOOKAHEAD_DAYS=17

# Delay between ForeUp API calls in milliseconds (avoids rate limiting)
API_CALL_DELAY_MS=1000

# Discord channel ID where open seat announcements are posted (optional)
# Right-click a channel → Copy Channel ID (requires Developer Mode in Discord settings)
OPEN_SEAT_CHANNEL_ID=
